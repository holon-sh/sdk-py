{
  "tools": [
    {
      "annotations": {
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List recent MCP calls to this app in its own deployment, newest first, at most 200 at a time. Filter by status and tool; pass the oldest start returned as before to read the page before it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "How far back to read: a duration such as 24h, or an RFC 3339 time. Defaults to 15m."
          },
          "status": {
            "type": "string",
            "description": "Only the calls that ended this way.",
            "enum": [
              "ok",
              "error"
            ]
          },
          "tool": {
            "type": "string",
            "description": "Only the calls to this tool."
          },
          "limit": {
            "type": "integer",
            "description": "The most calls to return. Defaults to 50, at most 200."
          },
          "before": {
            "type": "string",
            "description": "RFC 3339 time, exclusive: pass the oldest start returned to read the page before it."
          }
        },
        "additionalProperties": false
      },
      "name": "get_traces",
      "outputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "app": {
            "type": "string"
          },
          "traces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "traceId": {
                  "type": "string"
                },
                "start": {
                  "type": "string"
                },
                "app": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "error"
                  ]
                },
                "errorCode": {
                  "type": "integer"
                },
                "durationMs": {
                  "type": "integer"
                }
              },
              "required": [
                "traceId",
                "start",
                "method",
                "status",
                "durationMs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "session",
          "traces"
        ],
        "additionalProperties": false
      }
    }
  ]
}
